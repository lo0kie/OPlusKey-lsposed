<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的第三层 monochrome（API 33 起，`ic_launcher.xml` 里 `<monochrome>` 指向它）。
     主题图标模式下系统只取它的 alpha、用主题一色填上，必须是实心单色剪影（全用 #FFFFFF）。

     微调形状与前景层严格对齐：
     1. 箭头：流线箭身与圆润尖端；
     2. 侧键：修长实体键比例；
     3. 手机：5.6 宽窄边框；
     4. 面板：横竖两轴均留精准 3.2 宽缝（乘 0.78 后严格为 2.5dp 缝隙），等宽镂空负空间，消除缩放畸变。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:pivotX="54"
        android:pivotY="54">
    <!-- 箭头：精修流线箭身与圆润尖端 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M21.5,53.4H29.5Q31.5,53.4 31.5,55.4V59.8Q31.5,63.0 34.2,61.0L45.4,52.8Q48.2,50.55 45.4,48.3L34.2,40.1Q31.5,38.1 31.5,41.3V45.7Q31.5,47.7 29.5,47.7H21.5Q19.0,47.7 19.0,50.55Q19.0,53.4 21.5,53.4Z" />
    <!-- 侧键：修长旗舰实体按键 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52.0,46.5A2.0,2.0 0 0 1 56.0,46.5V54.5A2.0,2.0 0 0 1 52.0,54.5Z" />
    <!-- 手机：5.6 窄边框实心白 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M57.7,84.4V40.7Q57.7,23.7 74.7,23.7H90.1V29.3H75.5Q63.3,29.3 63.3,41.5V84.4Z" />
    <!-- 面板：等宽内缩 3.2（严格保持 2.5dp 均匀留白缝隙） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M66.5,84.4V42.5Q66.5,32.5 76.5,32.5H90.1V84.4Z" />
    </group>
</vector>
