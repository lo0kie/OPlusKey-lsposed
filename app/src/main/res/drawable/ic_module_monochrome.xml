<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的第三层 monochrome（API 33 起，`ic_launcher.xml` 里 `<monochrome>` 指向它）。
     主题图标模式下系统只取它的 alpha、用主题一色填上，所以必须是实心单色剪影（这里全用
     #FFFFFF），不能照抄前景层 88% / 36%→18% 那几档淡出（会被读成同色浅灰）。

     ⚠️ 面板与手机不能并成一块：面板按右下角为锚缩到 87.4% / 94.0%，左/上各留 3.2 宽缝
     （乘外层 0.78 后为 2.5），右边/下边与手机外沿齐平。内缩量 = 2.5 / 0.78 = 3.205，
     横竖两轴各算各的（等比缩放会让竖缝比横缝宽一倍，看着歪）。

     ⚠️ 字形同样缩在 0.78（同前景层安全区账）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:pivotX="54"
        android:pivotY="54">
    <!-- 箭头：按下去那一下 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20.8,54.1H29.9Q31.9,54.1 31.9,56.1V60.5Q31.9,63.9 34.6,61.8L45.6,53.2Q48.7,50.7 45.6,48.2L34.6,39.4Q31.9,37.3 31.9,40.7V45.1Q31.9,47.1 29.9,47.1H20.8Q18.2,47.1 18.2,49.7V51.5Q18.2,54.1 20.8,54.1Z" />
    <!-- 侧键：与手机左边框的间隙沿用前景层那份账（1.5） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.7,47.3A2.25,2.25 0 0 1 56.2,47.3V53.8A2.25,2.25 0 0 1 51.7,53.8Z" />
    <!-- 手机：左边框 + 上边框那圈（7 宽），前景层是 88% 淡出，这里实心 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M57.7,84.4V40.7Q57.7,23.7 74.7,23.7H90.1V30.6H76.7Q64.7,30.6 64.7,42.6V84.4Z" />
        <!-- 面板：内缩 3.205（右边 / 下边锚在手机上） -->
        <group
            android:scaleX="0.874"
            android:scaleY="0.940"
            android:pivotX="90.1"
            android:pivotY="84.4">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M64.7,84.4V42.6Q64.7,30.6 76.7,30.6H90.1V84.4Z" />
        </group>
    </group>
</vector>
