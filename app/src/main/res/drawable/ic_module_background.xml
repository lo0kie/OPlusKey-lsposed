<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的背景层：满幅 108×108 对角渐变（直角方形，外圈会被遮罩切掉）。

     方向固定为左上（深）→ 右下（浅），由用户指定，不要翻转。
     三档配色 #1540A6（左上）/ #2E6ADB（58%）/ #74A9F2（右下）；饱和度下限约 70%，再低会被读成蓝灰。

     ⚠️ 用多档 <item> 而非 start/center/endColor：中间那档要精确落在 58%（浅端在右下，
     让「深→中」吃掉对角线前 58%）；start/center/endColor 只能把中间钉在 50%。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF1540A6" />
                <item android:offset="0.58" android:color="#FF2E6ADB" />
                <item android:offset="1" android:color="#FF74A9F2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
