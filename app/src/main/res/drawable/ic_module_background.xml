<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的背景层：满幅 108×108 对角渐变（直角方形，外圈会被遮罩切掉）。

     方向固定为左上（深）→ 右下（浅），由用户指定，不要翻转。
     三档配色 #2E70EC（左上）/ #4B8BF3（52%）/ #72ACFA（右下）；
     再次提亮左上角起始基调，避免原深色偏暗偏沉，渐变过渡更柔和通透。

     注意：用多档 <item> 而非 start/center/endColor：中间那档要精确落在 52%（浅端在右下，
     让「深→中」吃掉对角线前 52%）；start/center/endColor 只能把中间钉在 50%。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF2E70EC" />
                <item android:offset="0.52" android:color="#FF4B8BF3" />
                <item android:offset="1" android:color="#FF72ACFA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
