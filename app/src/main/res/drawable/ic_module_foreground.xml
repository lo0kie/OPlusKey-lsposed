<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的前景层：只有字形，底色在背景层。

     字形：按下侧键 → 打开面板（照系统设置「快捷键」那一格）。
     微调形状：
     1. 箭头：收拢箭柄厚度（7.0 → 5.8），优化翼展流线与尖端曲线，消除粗笨感；
     2. 侧键：拉长修长比（宽 4.0，总高 12.0），增强实体侧键物理质感，小尺寸下不缩成圆点；
     3. 手机：边框由 7.0 收窄至 5.6，更具现代旗舰机窄边框质感；
     4. 面板：左上圆角自洽贴合内边框，提升通透玻璃感。

     注意：自适应图标有两套坐标：画布 108×108，启动器只取画布中央 72×72 铺满图标格。
     字形统一缩到 0.78（见下方 group），保持原有安全区账目。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:pivotX="54"
        android:pivotY="54">
    <!-- 箭头：精修流线箭身与圆润尖端 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M21.5,53.4H29.5Q31.5,53.4 31.5,55.4V59.8Q31.5,63.0 34.2,61.0L45.4,52.8Q48.2,50.55 45.4,48.3L34.2,40.1Q31.5,38.1 31.5,41.3V45.7Q31.5,47.7 29.5,47.7H21.5Q19.0,47.7 19.0,50.55Q19.0,53.4 21.5,53.4Z" />
    <!-- 侧键：靠手机左边框一侧，间距 1.7；宽 4.0、总高 12.0，呈修长旗舰实体按键质感 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52.0,46.5A2.0,2.0 0 0 1 56.0,46.5V54.5A2.0,2.0 0 0 1 52.0,54.5Z" />
    <!-- 手机：厚度 5.6 现代窄边框，与底同一条对角线淡出（纯白 → 92%） -->
    <path
        android:pathData="M57.7,84.4V40.7Q57.7,23.7 74.7,23.7H90.1V29.3H75.5Q63.3,29.3 63.3,41.5V84.4Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="57.7"
                android:startY="23.7"
                android:endX="90.1"
                android:endY="84.4"
                android:startColor="#FFFFFFFF"
                android:endColor="#EBFFFFFF" />
        </aapt:attr>
    </path>
    <!-- 面板：贴合 5.6 内边框，微调透光阶调（38% → 16%），呈现通透玻璃卡片质感 -->
    <path
        android:pathData="M63.3,84.4V41.5Q63.3,29.3 75.5,29.3H90.1V84.4Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="63.3"
                android:startY="29.3"
                android:endX="90.1"
                android:endY="84.4"
                android:startColor="#61FFFFFF"
                android:endColor="#29FFFFFF" />
        </aapt:attr>
    </path>
    </group>
</vector>
