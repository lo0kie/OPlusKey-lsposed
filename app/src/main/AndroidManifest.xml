<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      清单只有**一个** Activity：`EntryActivity` —— 无界面的跳板，不画任何东西。

      LSPosed 管理器右下角那颗「打开模块」FAB 按模块设置 category / CATEGORY_INFO /
      CATEGORY_LAUNCHER 的顺序找入口，命中任一条才显示。用户装完第一反应就是点那颗按钮，
      它不出现就等于「找不到入口」（真机反馈），所以声明这一个，点它转到宿主自己的侧键设置页。

      除它之外仍然一条都不许有：CATEGORY_INFO / LAUNCHER / activity-alias 全禁，
      CI 按「恰好一个 MODULE_SETTINGS + 恰好一个 activity 标签」核。

      下面这段注释里故意不写 category 全名：manifest merger 会把源清单注释抄进合并清单，
      写全名会让 CI 的计数从 1 变成 2。全名只出现在那个 intent-filter 里。
    -->

    <!--
      androidx 的传递依赖会经 merger 塞进 InitializationProvider 与 ProfileInstallReceiver，
      都不是入口但违背「零组件」，用 tools:node="remove" 删掉。
      remove 条目必须写在 <application> 里 —— 放在 <manifest> 层级会被静默忽略。
    -->
    <!--
      权限按 uid 判、不是按 APK：界面代码跑在宿主进程（uid 10277），在这里声明 `INTERNET`
      对它毫无作用（真机实证：宿主侧请求照样 `SecurityException`）。
    -->

    <!--
      图标走自适应图标（`mipmap-anydpi-v26/ic_launcher.xml`，底色 + 字形两层）。改回单张满幅
      矢量会被启动器当 legacy 图标补白底圆角并缩小。这只是图标属性，与入口无关。
    -->
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:ignore="MissingApplicationIcon">

        <!--
          这两条 `tools:node="remove"` 是**删掉**依赖合并进来的条目（模块零组件、没有自己的
          进程，不该在谁启动时跑它们的初始化）。

          `MissingClass` 这一档是**故意的**：`androidx.startup.InitializationProvider` 压根不在
          本模块的编译类路径上 —— 依赖的清单里有它、类在 `androidx.startup:startup-runtime` 里，
          而那个库不是本模块的直接依赖。少写这条 ignore，lint 会把它当成「清单引用了不存在的类」。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!--
          唯一一个界面组件：无界面的跳板。透明主题 + `noHistory`，起完自己就退场，
          用户看到的是宿主那一页 —— 见 `EntryActivity` 的类注释。
        -->
        <activity
            android:name=".EntryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>

</manifest>
