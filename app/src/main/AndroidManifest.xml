<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      清单只有**一个** Activity：`EntryActivity` —— 无界面的跳板，不画任何东西。

      LSPosed 管理器右下角那颗「打开模块」FAB 按模块设置 category / CATEGORY_INFO /
      CATEGORY_LAUNCHER 的顺序找入口，命中任一条才显示。用户装完第一反应就是点那颗按钮，
      它不出现就等于「找不到入口」（真机反馈），所以声明这一个，点它转到宿主自己的侧键设置页。

      除它之外仍然一条都不许有：CATEGORY_INFO / LAUNCHER / activity-alias 全禁，
      CI 按「恰好一个 MODULE_SETTINGS + 恰好一个 activity 标签」核。

      下面这段注释里故意不写 category 全名：manifest merger 会把源清单注释抄进合并清单，
      写全名会让 CI 的计数从 1 变成 2。全名只出现在那个 intent-filter 里。
    -->

    <!--
      androidx 的传递依赖会经 merger 塞进 InitializationProvider 与 ProfileInstallReceiver，
      都不是入口但违背「零组件」，用 tools:node="remove" 删掉。
      remove 条目必须写在 <application> 里 —— 放在 <manifest> 层级会被静默忽略。
    -->
    <!--
      权限按 uid 判、不是按 APK：界面代码跑在宿主进程（uid 10277），在这里声明 `INTERNET`
      对它毫无作用（真机实证：宿主侧请求照样 `SecurityException`）。
    -->

    <!--
      仅服务于「被叫醒那一下」：`ShizukuShellService` 要在 startForegroundService 之后 5 秒内
      转前台（见那个服务的 `onStartCommand`）。`specialUse` 是这一档唯一说得通的类型 —— 它既不是
      数据同步、也不是媒体播放，就是替宿主把进程拉起来守着一条 binder 通道。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      图标走自适应图标（`mipmap-anydpi-v26/ic_launcher.xml`，底色 + 字形两层）。改回单张满幅
      矢量会被启动器当 legacy 图标补白底圆角并缩小。这只是图标属性，与入口无关。
    -->
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:ignore="MissingApplicationIcon">

        <!--
          这两条 `tools:node="remove"` 是**删掉**依赖合并进来的条目（模块零组件、没有自己的
          进程，不该在谁启动时跑它们的初始化）。

          `MissingClass` 这一档是**故意的**：`androidx.startup.InitializationProvider` 压根不在
          本模块的编译类路径上 —— 依赖的清单里有它、类在 `androidx.startup:startup-runtime` 里，
          而那个库不是本模块的直接依赖。少写这条 ignore，lint 会把它当成「清单引用了不存在的类」。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!--
          唯一一个界面组件：无界面的跳板。透明主题 + `noHistory`，起完自己就退场，
          用户看到的是宿主那一页 —— 见 `EntryActivity` 的类注释。
        -->
        <activity
            android:name=".EntryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
          Shizuku 的 binder 通道：库靠这个 ContentProvider 接住 Shizuku 服务端送来的 binder
          （`rikka.shizuku.ShizukuProvider`，authorities 必须是 `<包名>.shizuku`）。
          没有它 `Shizuku.pingBinder()` 恒为 false —— 表现是「装了 Shizuku、也授权了，却一直报
          没有可用的 Shizuku」。权限那条按库的官方写法：只允许系统那一级跨用户来取。

          它只在**本模块自己的进程**里初始化（宿主进程不会跑别的包的 provider），所以不会影响注入侧。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          `shell:` 走 Shizuku 时的执行入口（`ShizukuShellService`）：宿主把命令转给本模块进程，
          由被授权的那个 uid 真正跑 —— 授权按 uid 记，宿主那个 uid 拿不到。

          `exported=true` 是为了让宿主 bind 得上；一条 `sh -c` 的入口不能对全机开放，所以服务
          自己再按调用方 uid 拦一道（只认自己与 `com.oplus.gesture`，见它的类注释）。

          `foregroundServiceType` 是**被叫醒那一下**要的（见 `ShizukuWakeBridge`）：模块进程没在
          跑时，只有 `startForegroundService` 那条路能过 AOSP 的「后台不许起服务」—— 而它要求
          5 秒内 `startForeground`。真机实测（`docs/device/lsposed.md` 四十二）：同样的调用方身份
          `uid 1000 + 包名 android` 走 `startService` 被 AOSP 拒、走前台那一档才放行。
        -->
        <service
            android:name="com.lookie.opluskey.command.shizuku.ShizukuShellService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="wake bridge for the side-key host" />
        </service>

        <!--
          开机 / 换包后把上面那个服务立成常驻（见 `BootReceiver` 的类注释）。`exported=false` 就够：
          `BOOT_COMPLETED` / `MY_PACKAGE_REPLACED` 都是系统发的，系统身份不受 `exported` 限制；
          写成 true 只是多开一个可以被第三方广播唤醒的落点。
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
