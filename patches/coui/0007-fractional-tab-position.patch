+/**
+ * Interpolate the indicator centre (first) and width (second) for a fractional [position].
+ *
+ * [position] follows the `PagerState.currentPage + PagerState.currentPageOffsetFraction`
+ * convention: `1.4` means 40% of the way from segment 1 to segment 2. Out-of-range values clamp to
+ * the first / last segment, so overscrolling holds the capsule against the edge instead of pushing
+ * it outside the row. Widths interpolate as well: with unequal segments the capsule should not jump
+ * in size at the halfway point.
+ */
+private fun interpolateIndicator(
+    position: Float,
+    lefts: List<Int>,
+    widths: List<Int>,
+): Pair<Float, Float> {
+    if (widths.isEmpty()) return 0f to 0f
+    val lastIndex = widths.lastIndex
+    val clamped = position.coerceIn(0f, lastIndex.toFloat())
+    val from = floor(clamped).toInt()
+    val to = min(from + 1, lastIndex)
+    val fraction = clamped - from
+    val fromCenter = lefts[from] + widths[from] / 2f
+    val toCenter = lefts[to] + widths[to] / 2f
+    val fromWidth = widths[from].toFloat()
+    val toWidth = widths[to].toFloat()
+    return (fromCenter + (toCenter - fromCenter) * fraction) to
+        (fromWidth + (toWidth - fromWidth) * fraction)
+}
